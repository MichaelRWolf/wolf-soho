#!/bin/bash

SHARE_NAME="Backups-TM-Michael-Air"
NAS_IP="192.168.8.129"
LOG_FILE="$HOME/Library/Logs/mount-tm-share.log"

mkdir -p "$(dirname "$LOG_FILE")"

log_ts() {
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" | tee -a "$LOG_FILE"
}

log_ts "BEGIN: Ensure TM share availability"

# Check if already mounted
if mount | grep -q "/Volumes/${SHARE_NAME}"; then
  log_ts "OK: $SHARE_NAME already mounted"
  exit 0
fi

# Check NAS is reachable (SMB port 445)
if ! nc -z -w 2 "$NAS_IP" 445 2>/dev/null; then
  log_ts "FAIL: NAS not reachable on SMB port"
  exit 1
fi

log_ts "OK: NAS is reachable; TM will mount on next backup"
exit 0

#!/usr/bin/env bash
# Analyze Time Machine exclusions for common system and user directories

set -euo pipefail

echo "=== Time Machine Status ==="
echo ""

# Check if TM is enabled
echo "TM Enabled:"
defaults read /Library/Preferences/com.apple.TimeMachine AutoBackup 2>/dev/null || echo "  [not configured]"

echo ""
echo "TM Destination:"
tmutil destinationinfo 2>/dev/null || echo "  [none configured]"

echo ""
echo "TM Destination Availability:"
# Extract IP from destination URL if network backup
DEST_INFO=$(tmutil destinationinfo 2>/dev/null)
if echo "$DEST_INFO" | grep -q "smb://"; then
  NAS_IP=$(echo "$DEST_INFO" | grep "smb://" | sed -E 's|.*@([0-9.]+)/.*|\1|')
  if [ -n "$NAS_IP" ] && [ "$NAS_IP" != "192.168.8.129" ] && [ "$NAS_IP" != "smb" ]; then
    echo "  NAS IP: $NAS_IP"
    if timeout 2 ping -c 1 "$NAS_IP" >/dev/null 2>&1; then
      echo "  Ping: ✓ Reachable"
    else
      echo "  Ping: ✗ Unreachable (offline or firewall blocked)"
    fi
  elif echo "$DEST_INFO" | grep -E "192\.168\.8\.129|wolfden" >/dev/null; then
    NAS_IP="192.168.8.129"
    echo "  NAS IP: $NAS_IP"
    if timeout 2 ping -c 1 "$NAS_IP" >/dev/null 2>&1; then
      echo "  Ping: ✓ Reachable"
    else
      echo "  Ping: ✗ Unreachable (offline or firewall blocked)"
    fi
  fi
fi

# Check if share is currently mounted
if mount | grep -q "Backups-TM-Wendy-Air"; then
  echo "  Mount status: ✓ Currently mounted"
  MOUNT_POINT=$(mount | grep "Backups-TM-Wendy-Air" | awk '{print $3}')
  echo "  Mount point: $MOUNT_POINT"
else
  echo "  Mount status: ✗ Not currently mounted"
fi

# Show last backup activity
LAST_BACKUP=$(defaults read /Library/Preferences/com.apple.TimeMachine LastBackupActivity 2>/dev/null)
if [ -n "$LAST_BACKUP" ]; then
  echo "  Last backup: $LAST_BACKUP"
fi

echo ""
echo "Full Time Machine plist:"
defaults read /Library/Preferences/com.apple.TimeMachine 2>/dev/null || echo "  [plist not readable or empty]"

echo ""
echo "=== End Status ==="
echo ""

# Directories to check (comprehensive list from tm-strategy.md audit framework)
# Organized by tier and category for easy reference

interesting_dirs=(
  # === TIER 1: High-Recovery-Value (Keep in TM) ===
  ~/Documents
  ~/Desktop
  ~/Pictures
  ~/Downloads
  ~/Movies
  ~/.ssh

  # === TIER 2: Medium-Recovery-Value (Mixed) ===
  ~/Library/Preferences
  ~/Library/Application\ Support
  ~/Library/Application\ Scripts
  ~/Library/Cookies
  ~/Library/HTTPStorages
  ~/Library/Safari
  ~/.config

  # === TIER 3: Low-Recovery-Value, Regenerable (Candidates for Exclusion) ===
  # Caches & Logs
  ~/Library/Caches
  ~/Library/Logs
  ~/Library/WebKit
  /Library/Caches

  # IDE indexes and build artifacts
  ~/Library/Developer
  ~/Library/Developer/Xcode
  ~/Library/Developer/Xcode/DerivedData
  ~/.vscode
  ~/.vscode/extensions

  # Language-specific package caches
  ~/.cache
  ~/.cache/pip
  ~/.cache/npm
  ~/.cache/uv
  ~/.gem
  ~/.cargo
  ~/.cargo/registry/cache
  ~/go/pkg/mod/cache

  # Homebrew caches
  ~/Library/Caches/Homebrew
  /Library/Caches/Homebrew
  /usr/local/Homebrew

  # === TIER 4: Unknown/Uncertain (System & Legacy) ===
  /Library
  /Library/LaunchDaemons
  /Library/LaunchAgents
  /Library/StartupItems
  /Users/Shared

  # === System Directories ===
  /Applications
  /System
  /opt
  /opt/homebrew
  /opt/local
  /opt/X11
  /private
  /private/var
  /private/var/log
  /private/tmp

  # === Decision: Excluded (2026-08-17) ===
  ~/Downloads
  ~/Pictures
  ~/repos
)

echo "=== Time Machine Exclusion Status ==="
echo ""

# Function to expand tilde
expand_path() {
  eval echo "$1"
}

# Check each directory
for dir in "${interesting_dirs[@]}"; do
  expanded_dir=$(expand_path "$dir")

  # Only check if path exists
  if [[ -e "$expanded_dir" ]] 2>/dev/null || [[ -L "$expanded_dir" ]] 2>/dev/null; then
      tmutil isexcluded "$expanded_dir"
  else
    printf "%-50s %s\n" "$dir" "[not found]" 2>&1
  fi
done

echo ""
echo "=== Directories with com.apple.metadata:com_apple_backup_excludeItem attribute ==="
echo "(Apple's native backup exclude markers)"
echo ""

# Find directories with backup exclude attribute
found_any=0
while IFS= read -r dir; do
  if [[ -n "$dir" ]]; then
    printf "%-50s (has backup exclude attribute)\n" "$dir"
    found_any=1
  fi
done < <(find ~ -maxdepth 4 -type d 2>/dev/null | while read -r dir; do
  xattr -p com.apple.metadata:com_apple_backup_excludeItem "$dir" >/dev/null 2>&1 && echo "$dir"
done | sort)

if [[ $found_any -eq 0 ]]; then
  echo "[none found]"
fi
